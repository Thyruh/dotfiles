#!/usr/bin/env bash

BINARY="main"
SOURCE="main.c"

CFLAGS="-Wall -Wextra -Wpedantic -g -O1 -fsanitize=address,undefined"
LDFLAGS="-fsanitize=address,undefined -lX11 -lXfixes"

if [ ! -f "$SOURCE" ]; then
    echo "No main.c in the current directory."
    exit 1
fi

gcc "$SOURCE" -o "$BINARY" $CFLAGS $LDFLAGS || exit 1

"./$BINARY" "$@"